# 复制到 /etc/android-agent/android-agent.env，权限必须为 600。
# 不要把真实密钥提交到 Git。
AGENT_PROVIDER=deepseek
AGENT_API_KEY=replace-with-model-provider-key

# 开放邮箱注册；生产环境同时开启邮箱验证。
AGENT_REGISTRATION_ENABLED=true
AGENT_EMAIL_VERIFICATION_REQUIRED=true
AGENT_SMTP_HOST=smtp.example.com
AGENT_SMTP_PORT=587
AGENT_SMTP_USERNAME=android-agent@example.com
AGENT_SMTP_PASSWORD=replace-with-smtp-password
AGENT_SMTP_FROM="Android Agent <android-agent@example.com>"
AGENT_SMTP_STARTTLS=true

# 管理后台。Token 至少 24 位，且不能复用模型 Key 或用户 Token。
AGENT_ADMIN_UI_ENABLED=false
AGENT_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# 单机部署保持 sqlite；扩容配置见 docs/CLOUD_DEPLOY.md。
AGENT_DEPLOYMENT_MODE=sqlite
