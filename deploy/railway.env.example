# 必填：在 Railway Service → Variables 中添加，不要提交真实值。
AGENT_PROVIDER=deepseek
AGENT_API_KEY=replace-with-deepseek-or-anthropic-key

# 首次注册阶段临时设为 true；账号创建完成后改回 false 并重新部署。
AGENT_REGISTRATION_ENABLED=true
AGENT_EMAIL_VERIFICATION_REQUIRED=false

# 多用户公网注册时改为 true，并填写 SMTP 配置。
# AGENT_EMAIL_VERIFICATION_REQUIRED=true
# AGENT_SMTP_HOST=smtp.example.com
# AGENT_SMTP_PORT=587
# AGENT_SMTP_USERNAME=android-agent@example.com
# AGENT_SMTP_PASSWORD=replace-with-smtp-password
# AGENT_SMTP_FROM=Android Agent <android-agent@example.com>
# AGENT_SMTP_STARTTLS=true

# 管理后台默认关闭。启用时 Token 必须为独立的 24 位以上随机值。
AGENT_ADMIN_UI_ENABLED=false
# AGENT_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Dockerfile 已提供以下默认值，一般不用在 Railway 重复设置：
# AGENT_CONFIG_PATH=/app/deploy/config.railway.yaml
# AGENT_DATA_DIR=/data/data
# AGENT_WORKSPACES_DIR=/data/workspaces
# AGENT_BUILDS_DIR=/data/builds
# GRADLE_USER_HOME=/data/gradle-cache
