# 复制为 config.yaml 并填写 API Key
# cp config.yaml.example config.yaml

# 主提供商: deepseek | anthropic
provider: deepseek
api_key: "sk-你的DeepSeek密钥"
base_url: https://api.deepseek.com
# DeepSeek V4：deepseek-v4-pro（推荐）/ deepseek-v4-flash（更快更省）
# 旧版 deepseek-chat / deepseek-reasoner 将于 2026-07-24 退役
model: deepseek-v4-pro
model_fallbacks:
  - deepseek-v4-flash

# 可选：提供商级备用
# provider_fallbacks:
#   - anthropic
# anthropic_api_key: "sk-你的Anthropic密钥"
# anthropic_base_url: https://api.anthropic.com
# anthropic_model: claude-sonnet-4-20250514

max_turns: 15
max_auto_continuations: 2  # 每 15 轮自动续接，2 表示最多共 45 轮
auto_build_after_edit: false

server_host: 127.0.0.1
server_port: 8000

# 推荐在服务端运行 `python3 -m agent register-user` 创建账号。
# 如确需开放网络注册，必须同时配置独立注册密钥：
# registration_enabled: true
# registration_token: "请换成随机长字符串"
# 也可通过环境变量 AGENT_REGISTRATION_TOKEN 提供注册密钥。
registration_enabled: false

# PTY 终端能够执行任意进程，默认关闭；仅在受信网络中按需启用。
terminal_enabled: false

# 资源治理与调试界面。Web UI 仅在 server_host 为 loopback 时挂载。
debug_web_ui_enabled: true
ws_ticket_ttl_seconds: 30
max_request_bytes: 2097152
max_prompt_chars: 100000
max_projects_per_user: 50
max_conversations_per_project: 200
max_active_tasks_per_user: 6
max_events_per_conversation: 100000
max_registration_per_hour: 20
max_requests_per_minute: 600
minimum_free_disk_bytes: 536870912
max_build_artifacts_per_project: 50
max_terminals_per_project: 5
max_mcp_servers_per_project: 10
max_memories_per_project: 1000
max_task_events_per_task: 20000

# 浏览器跨域来源精确白名单。手机原生客户端不受 CORS 限制。
cors_allowed_origins:
  - "null"
  - "http://127.0.0.1:8000"
  - "http://localhost:8000"

# 账号保存在 data/users.db，每个用户只能访问自己的项目。
# 可选：保留由管理员预设的固定账号（Token 不可为空）
# users:
#   - id: admin
#     token: "请换成随机长字符串"

# 部署模式：sqlite（默认单机）| postgres | hybrid
# postgres / hybrid 启动时若缺少 URL 会直接失败，不会降级到半残状态。
# deployment_mode: sqlite
# database_url: "postgresql://agent:secret@127.0.0.1:5432/android_agent"
# redis_url: "redis://127.0.0.1:6379/0"   # hybrid 下用于 ticket / 限流
# artifact_backend: local                 # local | object
# object_store_url: "s3://android-agent-artifacts"
# object_store_prefix: android-agent

# max_gradle_retries: 3
# compact_max_chars: 2500000  # 压缩阈值（字符）。V4 约 1M token，默认 250 万字符并预留输出余量
# max_output_tokens: 65536    # 单轮最大输出 token（V4 上限 384000）

# 网络搜索（Tavily）。配置后 Agent 可使用 web_search 工具。
# 申请 Key：https://tavily.com （也可用环境变量 TAVILY_API_KEY）
# tavily_api_key: "tvly-你的密钥"
