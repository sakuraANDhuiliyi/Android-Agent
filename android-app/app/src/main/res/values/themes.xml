<resources>
    <style name="Base.Theme.AndroidAgentClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/signal_primary</item>
        <item name="colorOnPrimary">@color/signal_on_primary</item>
        <item name="colorPrimaryContainer">@color/signal_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/signal_on_primary_container</item>
        <item name="colorSecondary">@color/signal_secondary</item>
        <item name="colorOnSecondary">@color/signal_on_secondary</item>
        <item name="colorSecondaryContainer">@color/signal_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/signal_on_secondary_container</item>
        <item name="colorTertiary">@color/signal_tertiary</item>
        <item name="colorOnTertiary">@color/signal_on_tertiary</item>
        <item name="colorSurface">@color/signal_surface</item>
        <item name="colorSurfaceVariant">@color/signal_surface_variant</item>
        <item name="colorOnSurface">@color/signal_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/signal_on_surface_variant</item>
        <item name="colorOutline">@color/signal_outline</item>
        <item name="colorOutlineVariant">@color/signal_outline_variant</item>
        <item name="colorError">@color/signal_error</item>
        <item name="colorOnError">@color/signal_on_error</item>
        <item name="colorErrorContainer">@color/signal_error_container</item>
        <item name="colorOnErrorContainer">@color/signal_on_error_container</item>
        <item name="android:statusBarColor">@color/signal_surface</item>
        <item name="android:navigationBarColor">@color/signal_navigation</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/signal_surface</item>
        <item name="materialButtonStyle">@style/Widget.AndroidAgent.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.AndroidAgent.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.AndroidAgent.Card</item>
        <item name="toolbarStyle">@style/Widget.AndroidAgent.Toolbar</item>
    </style>

    <style name="Theme.AndroidAgentClient" parent="Base.Theme.AndroidAgentClient" />

    <style name="Widget.AndroidAgent.Auth.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/auth_input_surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.AndroidAgent.Auth.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AndroidAgent.Auth.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.AndroidAgent.SearchInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/projects_card_surface</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxStrokeColor">?attr/colorOutlineVariant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.AndroidAgent.DrawerRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="ShapeAppearanceOverlay.AndroidAgent.Fab" parent="">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="JobDetailsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_medium</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="JobDetailsValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_tiny</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
