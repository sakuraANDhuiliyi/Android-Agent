<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One control scale for XML and dynamically-created workspace screens. -->
    <style name="Widget.AndroidAgent.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
    </style>
    <style name="Widget.AndroidAgent.Button.Outlined" parent="Widget.AndroidAgent.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/workbench_button_text</item>
        <item name="iconTint">@color/workbench_button_text</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.AndroidAgent.Button.Text" parent="Widget.AndroidAgent.Button.Outlined">
        <item name="strokeWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="Widget.AndroidAgent.Button.Tonal" parent="Widget.AndroidAgent.Button">
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">@color/workbench_tonal_text</item>
        <item name="iconTint">@color/workbench_tonal_text</item>
    </style>
    <style name="Widget.AndroidAgent.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/projects_card_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.AndroidAgent.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">56dp</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.AndroidAgent.Toolbar</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.AndroidAgent.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
