<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowCluster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_small"
        android:paddingEnd="@dimen/space_tiny">

        <ImageView
            android:id="@+id/iconCluster"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tool_generic" />

        <TextView
            android:id="@+id/textClusterTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_small"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="读取 4 个文件" />

        <TextView
            android:id="@+id/textClusterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_small"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="1.3s" />

        <ImageView
            android:id="@+id/iconClusterExpand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/expand"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_expand_arrow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutClusterMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_small"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
