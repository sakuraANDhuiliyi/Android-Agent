<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/projects" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/hubScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_small"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="96dp">

            <TextView
                android:id="@+id/textHubName"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                tools:text="My App" />

            <TextView
                android:id="@+id/textHubPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="com.example.myapp" />

            <TextView
                android:id="@+id/textHubStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="上次构建成功 · 12 分钟前" />

            <TextView
                android:id="@+id/textBranch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="main · 6 个文件待审查" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingApproval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/badge_pending_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/badge_pending_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/status_awaiting"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/badge_pending_text" />

                        <TextView
                            android:id="@+id/textPendingMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hub_pending_cta"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/badge_pending_text" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textQuickContinueTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        tools:text="继续「修复登录问题」" />

                    <TextView
                        android:id="@+id/textQuickContinueMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        tools:text="12 分钟前 · 已完成" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingBottom="8dp"
                android:text="@string/project_overview"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_task" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView android:id="@+id/textCurrentTaskTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textAppearance="?attr/textAppearanceTitleMedium" tools:text="● Implement dark mode" />
                    <TextView android:id="@+id/textCurrentTaskMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" tools:text="正在读取 4 个文件 · 01:24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:weightSum="2">
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardChangesSummary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="@dimen/radius_card" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workspace_changes" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" /><TextView android:id="@+id/textChangesSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="?attr/textAppearanceTitleSmall" tools:text="6 files · +128 −42" /></LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardBuildSummary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="@dimen/radius_card" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workspace_build" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" /><TextView android:id="@+id/textBuildSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="?attr/textAppearanceTitleSmall" tools:text="✓ assembleDebug · 42s" /></LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:weightSum="2">
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardTestsSummary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="@dimen/radius_card" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workspace_tests" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" /><TextView android:id="@+id/textTestsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="?attr/textAppearanceTitleSmall" tools:text="✓ 27 passed" /></LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardProblemsSummary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="@dimen/radius_card" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workspace_problems" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" /><TextView android:id="@+id/textProblemsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="?attr/textAppearanceTitleSmall" tools:text="⚠ 3 warnings" /></LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/projects_card_surface"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hub_apk_ready"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:id="@+id/textApkMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="查看 APK" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewApk"
                        style="@style/Widget.AndroidAgent.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/hub_view_apk" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingBottom="@dimen/space_small"
                android:text="@string/recent_conversations"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerConversations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/textEmptyConversations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="@string/hub_no_conversations"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/workspace_sections"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/rowConversations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:padding="16dp" android:drawablePadding="12dp" android:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical" android:drawableStart="@drawable/ic_nav_activity" android:text="@string/workspace_conversations" android:textAppearance="?attr/textAppearanceBodyLarge" android:background="@drawable/bg_soft_list_row" /></com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                app:rippleColor="@color/signal_primary_container"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:padding="16dp"
                    android:text="@string/hub_workspace_files"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    app:drawableStartCompat="@drawable/ic_tool_read" android:background="@drawable/bg_soft_list_row" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                app:rippleColor="@color/signal_primary_container"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:padding="16dp"
                    android:text="@string/hub_changes"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    app:drawableStartCompat="@drawable/ic_tool_edit" android:background="@drawable/bg_soft_list_row" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowBuild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                app:rippleColor="@color/signal_primary_container"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:padding="16dp"
                    android:text="@string/hub_build_apk"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    app:drawableStartCompat="@drawable/ic_tool_command" android:background="@drawable/bg_soft_list_row" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/rowProblems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:padding="16dp" android:text="@string/workspace_problems" android:textAppearance="?attr/textAppearanceBodyLarge" android:background="@drawable/bg_soft_list_row" /></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/rowTerminal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:padding="16dp" android:drawablePadding="12dp" android:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical" android:drawableStart="@drawable/ic_tool_command" android:text="@string/workspace_terminal" android:textAppearance="?attr/textAppearanceBodyLarge" android:background="@drawable/bg_soft_list_row" /></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/rowContext" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:padding="16dp" android:drawablePadding="12dp" android:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical" android:drawableStart="@drawable/ic_tool_read" android:text="@string/workspace_context" android:textAppearance="?attr/textAppearanceBodyLarge" android:background="@drawable/bg_soft_list_row" /></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/rowHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:padding="16dp" android:drawablePadding="12dp" android:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical" android:drawableStart="@drawable/ic_history" android:text="@string/workspace_history" android:textAppearance="?attr/textAppearanceBodyLarge" android:background="@drawable/bg_soft_list_row" /></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/rowSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" app:cardCornerRadius="0dp" app:cardBackgroundColor="?attr/colorSurface" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="0dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:padding="16dp" android:drawablePadding="12dp" android:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical" android:drawableStart="@drawable/ic_settings" android:text="@string/workspace_settings" android:textAppearance="?attr/textAppearanceBodyLarge" android:background="@drawable/bg_soft_list_row" /></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewConversation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_margin"
        android:contentDescription="@string/new_conversation"
        android:src="@drawable/ic_send"
        app:tint="?attr/colorOnPrimary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
