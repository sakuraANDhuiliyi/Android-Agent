<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AgentApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidAgentClient"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <receiver android:name=".ApprovalActionReceiver" android:exported="false" />
        <activity android:name=".ProjectHistoryActivity" android:exported="false" />
        <activity android:name=".RemoteTerminalActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AgentsActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainNavActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConnectionSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainNavActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VerifyEmailActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AccountSecurityActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ChangePasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DevicesActivity" android:exported="false" />
        <activity android:name=".ModelApiActivity" android:exported="false" />
        <activity android:name=".ProviderKeyActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".TokenUsageActivity" android:exported="false" />
        <activity android:name=".TokenUsageDetailActivity" android:exported="false" />
        <activity android:name=".NotificationSettingsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".PermissionsActivity" android:exported="false" />

        <activity
            android:name=".ProjectDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainNavActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ConversationActivity"
            android:exported="false"
            android:parentActivityName=".ProjectDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DiffActivity"
            android:exported="false"
            android:parentActivityName=".ProjectDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FileDiffActivity"
            android:exported="false"
            android:parentActivityName=".DiffActivity" />

        <activity
            android:name=".BuildLogActivity"
            android:exported="false"
            android:parentActivityName=".ConversationActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".FeedbackActivity" android:exported="false" android:parentActivityName=".ProjectDetailActivity" />

        <activity
            android:name=".ApkActivity"
            android:exported="false"
            android:parentActivityName=".ProjectDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TheokitShowcaseActivity"
            android:exported="false"
            android:parentActivityName=".MainNavActivity" />

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:parentActivityName=".ProjectDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProjectConfigActivity"
            android:exported="false"
            android:parentActivityName=".ProjectDetailActivity" />

        <activity
            android:name=".RulesActivity"
            android:exported="false"
            android:parentActivityName=".ProjectConfigActivity" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:parentActivityName=".ProjectConfigActivity" />

        <activity
            android:name=".SkillsActivity"
            android:exported="false"
            android:parentActivityName=".ProjectConfigActivity" />

        <activity
            android:name=".McpServersActivity"
            android:exported="false"
            android:parentActivityName=".ProjectConfigActivity" />

        <activity
            android:name=".PermissionProfileActivity"
            android:exported="false"
            android:parentActivityName=".ProjectConfigActivity" />

        <activity
            android:name=".UsageInspectorActivity"
            android:exported="false"
            android:parentActivityName=".ProjectConfigActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
