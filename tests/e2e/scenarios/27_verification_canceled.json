{
  "id": "27_verification_canceled",
  "title": "取消真实运行中的单测",
  "prompt": "执行本任务的构建与测试并保存证据",
  "auto_approve": true,
  "setup_files": {
    "gradlew": {
      "executable": true,
      "content": "#!/bin/sh\nset -eu\ncase \"$1\" in\nassembleDebug)\n mkdir -p app/build/outputs/apk/debug\n printf E2E-APK > app/build/outputs/apk/debug/app-debug.apk\n ;;\ntestDebugUnitTest)\n echo TESTS_STARTED\n sleep 30\n ;;\nesac\necho BUILD SUCCESSFUL\n"
    },
    "gradle.properties": {
      "content": "verification.input=original\n"
    }
  },
  "steps": [
    {
      "type": "tool",
      "calls": [
        {
          "name": "run_gradle",
          "arguments": {
            "task": "testDebugUnitTest"
          }
        }
      ]
    },
    {
      "type": "final",
      "text": "验证证据已收集。"
    }
  ],
  "expect": {
    "verification": {
      "build": {
        "state": "not_run",
        "source_match": "unknown"
      },
      "unit_tests": {
        "state": "canceled",
        "source_match": "match",
        "counts": null
      }
    }
  },
  "driver": "cancel_after_tool_call"
}
